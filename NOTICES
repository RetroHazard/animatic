use crate::common::f_fmla;
use crate::hyperbolic::asinhf::log_eval;

/// Hyperbolic arc cosine function
///
/// Max ULP 0.5
#[inline]
pub fn f_acoshf(x: f32) -> f32 {
    if x <= 1.0 {
        if x == 1.0 {
            return 0.0;
        }
        // x < 1.
        return f32::NAN;
    }

    if !x.is_finite() {
        return x;
    }
    let x_d = x as f64;
    // acosh(x) = log(x + sqrt(x^2 - 1))
    log_eval(x_d + (f_fmla(x_d, x_d, -1.0).sqrt())) as f32
}

