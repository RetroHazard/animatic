    use super::*;

    #[test]
    fn test_trunc() {
        assert_eq!(trunc(-1.0), -1.0);
        assert_eq!(trunc(1.0), 1.0);
        assert_eq!(trunc(1.234211), 1.0);
        assert_eq!(trunc(-1.234211), -1.0);
        assert_eq!(trunc(f64::INFINITY), f64::INFINITY);
        assert_eq!(trunc(f64::NEG_INFINITY), f64::NEG_INFINITY);
        assert!(trunc(f64::NAN).is_nan());
    }
}



