# Files embedded into the binaries with include_str! must have the same bytes on every
# platform. Without this, a Windows checkout with core.autocrlf=true embeds CRLF.
crates/animatic-core/src/rename/*_pattern.txt text eol=lf
crates/animatic-core/src/db/schema.sql text eol=lf
# Shown by Help → About Animatic → View license and Third-party notices.
/LICENSE text eol=lf
/NOTICES text eol=lf
# Template of NOTICES: LF on every platform so local and CI generation give the same bytes.
/about.hbs text eol=lf

# Application icon (crates/animatic/assets), embedded with include_bytes! and the Windows resource compiler.
*.png binary
*.ico binary
